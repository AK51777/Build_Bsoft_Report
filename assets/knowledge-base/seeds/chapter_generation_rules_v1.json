{
  "schema_version": "1.0",
  "global": {
    "forbidden_output_phrases": [
      "经核验的相关条款主要包括",
      "正式报审前还需复核",
      "不得把指导、鼓励或评价性内容改写为项目已经完成的事实",
      "事实台账",
      "章节复核",
      "进入下一轮深化时",
      "新增材料应按来源",
      "只有目录标题而没有官方原文"
    ],
    "completion_checks": [
      "仅使用章节任务包绑定的事实、范围、政策、能力和语料",
      "工作层来源标记不得转化为面向客户的编制过程说明",
      "未通过当前章节校验的版本不得采纳"
    ],
    "validation": {
      "require_task_package_boundary": true
    }
  },
  "roles": {
    "project_overview": {
      "argument_outline": ["项目定位与编制边界", "建设范围分类", "建设方式与依赖", "验收与决策边界"],
      "assembly_mode": "fact_scope_argument",
      "required_source_types": ["fact", "scope"]
    },
    "basis": {
      "argument_outline": ["政策类依据", "行业标准依据", "安全类标准依据", "投资估算编制依据"],
      "assembly_mode": "four_group_verified_basis",
      "required_source_types": ["fact", "policy", "reference"],
      "validation": {
        "require_policy_basis_minimum": 16,
        "require_industry_standard_minimum": 20,
        "require_security_standard_minimum": 16,
        "require_investment_basis_minimum": 5
      }
    },
    "policy_background": {
      "argument_outline": ["国家政策背景", "省/自治区政策背景", "市/项目建设地区政策背景"],
      "assembly_mode": "jurisdiction_policy_background",
      "required_source_types": ["fact", "policy", "reference"],
      "validation": {
        "require_verified_clause_for_prose": true,
        "require_ordered_policy_basis_subsequence": true,
        "require_national_background_minimum": 8,
        "require_province_background_minimum": 2,
        "require_prefecture_background_minimum": 1
      }
    },
    "current_state": {
      "argument_outline": ["资料边界与核实口径", "评级基线与发展目标", "业务运行现状", "应用系统现状", "数据与接口现状", "基础环境现状", "安全现状", "运维现状", "待核实事项"],
      "assembly_mode": "fact_argument",
      "required_source_types": ["fact"],
      "completion_checks": [
        "评级目标、当前评级、参评状态和调研事实分别绑定",
        "未参评不换算为零级，评级差异不直接推导具体能力缺口",
        "拟建清单只作为调研线索，不作为医院现状证据"
      ]
    },
    "problem_need": {
      "argument_outline": ["证据支持的问题表现", "成因与影响链", "建设需求响应", "范围承载与优先关系"],
      "assembly_mode": "traceability_argument",
      "required_source_types": ["fact", "scope"]
    },
    "necessity_feasibility": {
      "argument_outline": ["政策必要性", "业务必要性", "技术可行性", "数据与安全可行性", "实施条件与约束"],
      "assembly_mode": "knowledge_fact_argument",
      "required_source_types": ["fact", "scope", "policy", "corpus"]
    },
    "overall_design": {
      "argument_outline": ["建设原则", "总体目标", "业务与应用架构", "数据与集成架构", "技术与安全架构", "验收闭环"],
      "assembly_mode": "knowledge_scope_argument",
      "required_source_types": ["scope", "policy", "corpus"]
    },
    "construction_content": {
      "argument_outline": ["客户清单范围", "能力映射", "功能流程", "数据接口", "安全控制", "验收取证"],
      "assembly_mode": "scope_capability_standard_blocks",
      "required_source_types": ["scope", "capability", "corpus"],
      "validation": {
        "require_scope_coverage": true,
        "require_dynamic_outline": true
      }
    },
    "implementation_operation": {
      "argument_outline": ["项目治理与组织分工", "阶段计划与成果物", "配置和开发管理", "数据迁移", "测试与上线切换", "培训与知识转移", "运维服务与SLA", "质量安全和变更控制"],
      "assembly_mode": "knowledge_scope_argument",
      "required_source_types": ["scope", "corpus"]
    },
    "investment_funding": {
      "argument_outline": ["估算范围与口径", "范围和费用映射", "计价依据与复核", "资金来源和年度安排", "概算变更控制"],
      "assembly_mode": "fact_scope_calculation",
      "required_source_types": ["fact", "scope"]
    },
    "benefit_performance": {
      "argument_outline": ["医疗服务效益", "临床与质量效益", "运营管理效益", "数据与安全效益", "社会效益", "指标定义与取证", "基线目标和评价机制"],
      "assembly_mode": "traceability_argument",
      "required_source_types": ["fact", "scope", "corpus"]
    },
    "risk": {
      "argument_outline": ["政策与合规风险", "范围与需求风险", "数据迁移风险", "接口与技术风险", "网络数据安全风险", "进度质量与运维风险"],
      "assembly_mode": "risk_control_argument",
      "required_source_types": ["fact", "scope", "policy"]
    },
    "conclusion": {
      "argument_outline": ["研究判断", "推进条件", "待确认前置事项", "后续工作建议"],
      "assembly_mode": "evidence_summary",
      "required_source_types": ["fact", "scope"]
    }
  },
